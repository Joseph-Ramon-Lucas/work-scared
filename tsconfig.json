{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules"],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "postcss.config.js"
  ],
  "compilerOptions": {
    "skipLibCheck": true, //skips check on .d.ts files
    "paths": {
      "~*": ["./*"]
    },
    "baseUrl": "."
  }
}
